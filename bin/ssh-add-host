#!/bin/bash

# SSH Server Add Tool - Auto-configure passwordless login
# Usage: ssh-add-host [alias] [username] [address] [port]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# SSH config directories
SSH_DIR="$HOME/.ssh"
CONFIG_FILE="$SSH_DIR/config"

# Ensure SSH directory exists
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

# Check dependencies
check_dependencies() {
    if ! command -v ssh &>/dev/null; then
        echo -e "${RED}Error: ssh command not found${NC}"
        exit 1
    fi
}

# Load a key into ssh-agent so the passphrase is typed once, not per connection.
# macOS persists it in the Keychain; Windows' agent service persists it via DPAPI;
# on Linux the agent holds it for the login session.
add_key_to_agent() {
    local key_file="$1"

    # ssh-add -l: 0 = agent has keys, 1 = agent running but empty, 2 = no agent.
    # Capture the code explicitly; `set -e` would abort on a bare nonzero exit.
    local rc=0
    ssh-add -l &>/dev/null || rc=$?

    if [[ $rc -eq 2 ]]; then
        echo -e "${YELLOW}⚠ No ssh-agent running — start one with: eval \$(ssh-agent)${NC}"
        echo -e "${YELLOW}  Then run: ssh-add $key_file${NC}"
        return 0
    fi

    if [[ "$(uname -s)" == "Darwin" ]]; then
        ssh-add --apple-use-keychain "$key_file" 2>/dev/null \
            || ssh-add -K "$key_file" 2>/dev/null \
            || ssh-add "$key_file" \
            || true
    else
        ssh-add "$key_file" || true
    fi

    echo -e "${GREEN}✓ Key loaded into ssh-agent${NC}"
}

# Check and generate SSH key
check_and_generate_key() {
    local key_type="${1:-ed25519}"
    local key_file="$SSH_DIR/id_${key_type}"

    if [[ -f "$key_file" ]]; then
        echo -e "${GREEN}✓ SSH key exists: $key_file${NC}"
        return 0
    fi

    echo -e "${YELLOW}No SSH key found, generating...${NC}"
    read -p "Enter key comment (usually email) [$(whoami)@$(hostname)]: " key_comment
    key_comment=${key_comment:-"$(whoami)@$(hostname)"}

    # A passphrase encrypts the key at rest: a stolen key file is then useless
    # on its own. It costs no convenience, because ssh-agent (configured below)
    # asks for it once and every later connection is non-interactive.
    # SSH_ADD_HOST_NO_PASSPHRASE=1 opts out, for CI and other unattended runs.
    if [[ "${SSH_ADD_HOST_NO_PASSPHRASE:-}" == "1" ]]; then
        echo -e "${YELLOW}⚠ Generating key WITHOUT a passphrase (SSH_ADD_HOST_NO_PASSPHRASE=1)${NC}"
        ssh-keygen -t "$key_type" -C "$key_comment" -f "$key_file" -N ""
    else
        echo -e "${CYAN}Set a passphrase — ssh-agent will only ask for it once.${NC}"
        ssh-keygen -t "$key_type" -C "$key_comment" -f "$key_file"
    fi

    chmod 600 "$key_file"
    echo -e "${GREEN}✓ SSH key generated: $key_file${NC}"

    add_key_to_agent "$key_file"

    echo -e "${CYAN}Public key content:${NC}"
    cat "${key_file}.pub"
}

AGENT_BEGIN="# >>> dotfiles ssh-agent >>>"
AGENT_END="# <<< dotfiles ssh-agent <<<"

# The canonical block lives in the repo at ssh/agent.conf. This script is
# symlinked into ~/.local/bin, so resolve the symlink to find it. Used on its
# own, with no repo around, it falls back to the copy below.
repo_agent_conf() {
    local src="${BASH_SOURCE[0]}" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    echo "$dir/../ssh/agent.conf"
}

embedded_agent_block() {
    cat <<'EOF_BLOCK'
Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    UseKeychain yes
EOF_BLOCK
}

# Make ssh hand keys to the agent, so a passphrase-protected key is unlocked once
# instead of on every connection.
#
# This is written as a literal `Host *` block rather than an Include. ssh_config
# has no block terminators, so an Include inherits the scope of whatever Host
# block precedes it: the day another tool (VS Code Remote, OrbStack, ...) prepends
# a block to ~/.ssh/config, an Include below it silently applies to that one host
# only. A `Host *` block starts its own scope and reaches every host from anywhere
# in the file.
ensure_agent_config() {
    local source_conf="${1:-$(repo_agent_conf)}"
    local block

    if [[ -r "$source_conf" ]]; then
        block="$(cat "$source_conf")"
    else
        block="$(embedded_agent_block)"
    fi

    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    # AddKeysToAgent set outside our markers means someone wrote a block by hand.
    # Guessing its boundaries in order to replace it is how you delete half of
    # somebody's ssh config, so leave it be and say why.
    # Match the directive at the start of a line, not the word inside a comment.
    if ! grep -Fq "$AGENT_BEGIN" "$CONFIG_FILE" && grep -qE '^[[:space:]]*AddKeysToAgent' "$CONFIG_FILE"; then
        echo -e "${YELLOW}⚠ ~/.ssh/config already sets AddKeysToAgent outside the dotfiles markers${NC}"
        echo -e "${YELLOW}  Leaving it untouched. Remove it by hand to let dotfiles manage the block.${NC}"
        return 0
    fi

    local backup tmp
    backup="$CONFIG_FILE.agent-bak.$(date +%Y%m%d_%H%M%S)"
    cp "$CONFIG_FILE" "$backup"
    tmp="$(mktemp)"

    if grep -Fq "$AGENT_BEGIN" "$CONFIG_FILE"; then
        # Replace in place, so editing ssh/agent.conf and re-running updates it.
        # The block is spliced with two awk passes rather than passed in via -v:
        # awk -v cannot carry a value containing newlines.
        {
            awk -v b="$AGENT_BEGIN" '$0 == b { exit } { print }' "$CONFIG_FILE"
            echo "$AGENT_BEGIN"
            printf '%s\n' "$block"
            echo "$AGENT_END"
            awk -v e="$AGENT_END" 'found { print } $0 == e { found = 1 }' "$CONFIG_FILE"
        } > "$tmp"
    else
        # Appended, not prepended. A `Host *` block reaches every host from
        # anywhere in the file, so there is nothing to gain by going first — and
        # plenty to lose: ssh_config has no block terminators, so a block at the
        # top swallows every top-level directive below it into its scope. Real
        # configs have those. OrbStack's own Include even documents that it "only
        # works if it's at the top of ssh_config (before any Host blocks)".
        {
            cat "$CONFIG_FILE"
            echo ""
            echo "$AGENT_BEGIN"
            printf '%s\n' "$block"
            echo "$AGENT_END"
        } > "$tmp"
    fi

    mv "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    # A malformed config breaks every ssh on the machine, so prove it still parses.
    # -F is not optional: ssh locates ~/.ssh/config through the passwd database
    # and ignores $HOME, so a bare `ssh -G` would validate a different file than
    # the one just written.
    if ! ssh -F "$CONFIG_FILE" -G localhost >/dev/null 2>&1; then
        mv "$backup" "$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
        echo -e "${RED}✗ ssh rejected the new config — restored the previous one${NC}"
        return 1
    fi

    rm -f "$backup"
    echo -e "${GREEN}✓ ssh-agent block in ~/.ssh/config${NC}"
}

# One file per host, so adding, replacing and removing a server is a file
# operation. The code this replaces located a Host block by line number and ran
# `sed '<start>,<end>d'` across the whole of ~/.ssh/config — a standing invitation
# to delete someone else's hosts whenever the boundary was computed wrong.
HOSTS_DIR="$SSH_DIR/config.d"

host_conf_file() {
    echo "$HOSTS_DIR/$1.conf"
}

# ~/.ssh/config has to pull the per-host files in. Mind the glob: OpenSSH uses
# glob(3), where ** is NOT recursive — it is just two *, and * never crosses a
# "/". So `config.d/*.conf` matches flat files, while `config.d/**/*.conf` matches
# only files exactly one directory deep. Get this wrong and every host silently
# disappears: ssh reports no error, it just treats the alias as a literal hostname.
INCLUDE_LINE="Include config.d/*.conf"

ensure_include() {
    mkdir -p "$HOSTS_DIR"
    chmod 700 "$HOSTS_DIR"

    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    if grep -qxF "$INCLUDE_LINE" "$CONFIG_FILE"; then
        return 0
    fi

    backup_config
    local tmp
    tmp="$(mktemp)"

    if grep -qE '^[[:space:]]*Include[[:space:]]+config\.d/' "$CONFIG_FILE"; then
        # Upgrade an older glob (e.g. config.d/**/*.conf) in place.
        awk -v line="$INCLUDE_LINE" \
            '/^[[:space:]]*Include[[:space:]]+config\.d\// { print line; next } { print }' \
            "$CONFIG_FILE" > "$tmp"
        echo -e "${GREEN}✓ Include glob updated in ~/.ssh/config${NC}"
    else
        # An Include must sit before any Host block: ssh_config has no block
        # terminators, so one placed lower is scoped to the Host block above it
        # and is skipped for every other host.
        { echo "$INCLUDE_LINE"; cat "$CONFIG_FILE"; } > "$tmp"
        echo -e "${GREEN}✓ Include added to ~/.ssh/config${NC}"
    fi

    mv "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

# A leftover entry in ~/.ssh/config is read before the Include and wins, so it
# would silently shadow the file this tool is about to write.
warn_if_host_in_main_config() {
    local host="$1"
    grep -qE "^Host[[:space:]]+([^[:space:]]+[[:space:]]+)*${host}([[:space:]]|$)" \
        "$CONFIG_FILE" 2>/dev/null || return 0

    echo -e "${YELLOW}⚠ '$host' is also defined directly in ~/.ssh/config${NC}"
    echo -e "${YELLOW}  Remove it there, or it will shadow $(host_conf_file "$host")${NC}"
}

# Handle duplicate Host
handle_duplicate_host() {
    local host="$1"
    local conf
    conf="$(host_conf_file "$host")"

    [[ -f "$conf" ]] || return 0

    echo -e "${YELLOW}⚠ Host alias '$host' already exists: $conf${NC}"
    echo -e "${CYAN}Existing config:${NC}"
    sed 's/^/  /' "$conf"

    echo ""
    echo "Choose an action:"
    echo "  1) Overwrite - Replace it with the new config"
    echo "  2) Skip - Keep existing config and exit"
    echo "  3) Rename - Use a different alias"

    while true; do
        read -p "Enter option [1/2/3]: " choice
        case $choice in
            1)
                rm -f "$conf"
                echo -e "${GREEN}✓ Existing config removed${NC}"
                return 0
                ;;
            2)
                echo "Operation cancelled, existing config preserved"
                exit 0
                ;;
            3)
                read -p "Enter new host alias: " new_host
                if [[ -z "$new_host" ]]; then
                    echo -e "${RED}Alias cannot be empty${NC}"
                    continue
                fi
                HOST_ALIAS="$new_host"
                handle_duplicate_host "$new_host"
                return $?
                ;;
            *)
                echo -e "${RED}Invalid option, please try again${NC}"
                ;;
        esac
    done
}

# Backup config file
backup_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local backup_file="$CONFIG_FILE.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$CONFIG_FILE" "$backup_file"
        echo -e "${BLUE}Config backed up to: $backup_file${NC}"
    fi
}

# Write the host to its own file under ~/.ssh/config.d/
add_to_config() {
    local host="$1"
    local hostname="$2"
    local user="$3"
    local port="${4:-22}"
    local identity_file="${5:-$SSH_DIR/id_ed25519}"

    identity_file="${identity_file/#\~/$HOME}"

    ensure_include
    ensure_agent_config

    warn_if_host_in_main_config "$host"
    handle_duplicate_host "$host"

    local conf
    conf="$(host_conf_file "$host")"

    {
        echo "Host $host"
        echo "    HostName $hostname"
        echo "    User $user"
        echo "    Port $port"
        echo "    IdentityFile $identity_file"
        echo "    IdentitiesOnly yes"
        echo "    ServerAliveInterval 60"
        echo "    ServerAliveCountMax 3"
    } > "$conf"
    chmod 600 "$conf"

    echo -e "${GREEN}✓ SSH config written: $conf${NC}"
}

# Remove a host: one file, so nothing else can be caught in the blast.
remove_host() {
    local host="$1"
    local conf
    conf="$(host_conf_file "$host")"

    if [[ ! -f "$conf" ]]; then
        echo -e "${RED}✗ No such host: $host ($conf)${NC}"
        if grep -qE "^Host[[:space:]]+.*${host}" "$CONFIG_FILE" 2>/dev/null; then
            echo -e "${YELLOW}  It is defined directly in ~/.ssh/config — remove it there by hand.${NC}"
        fi
        return 1
    fi

    rm -f "$conf"
    echo -e "${GREEN}✓ Removed $conf${NC}"
}

# Concrete host aliases defined directly in ~/.ssh/config. Pattern blocks
# (Host *, Host *.example.com, ...) are deliberately excluded: they are defaults
# whose whole meaning is their position in the file, and hoisting one into an
# Include at the top would change which value ssh sees first.
list_main_config_hosts() {
    [[ -f "$CONFIG_FILE" ]] || return 0
    awk '
        /^[[:space:]]*Host[[:space:]]+/ {
            rest = $0
            sub(/^[[:space:]]*Host[[:space:]]+/, "", rest)
            if (rest ~ /[*?!]/) next
            print $2
        }
    ' "$CONFIG_FILE"
}

# What ssh actually resolves for a host, which is the only definition of "nothing
# changed" that means anything. Keyword order in `ssh -G` is not stable, so sort.
snapshot_host() {
    ssh -F "$CONFIG_FILE" -G "$1" 2>/dev/null | sort
}

# Move each concrete Host block out of ~/.ssh/config and into its own file.
#
# Splitting can silently change behaviour. ssh takes the FIRST value it sees for
# a keyword, so a `Host *` block sitting above a host block currently wins over
# it. Move that host into config.d and the Include at the top makes it win
# instead — verified: a host inheriting ServerAliveInterval 60 from `Host *`
# started reporting its own 30, with no error anywhere. So every host is compared
# before and after, and anything that moves rolls the whole thing back.
split_config() {
    local hosts
    hosts="$(list_main_config_hosts)"

    if [[ -z "$hosts" ]]; then
        echo -e "${GREEN}✓ Nothing to split — no hosts defined directly in ~/.ssh/config${NC}"
        return 0
    fi

    echo -e "${BLUE}These hosts will move out of ~/.ssh/config into $HOSTS_DIR/:${NC}"
    echo "$hosts" | sed 's/^/  /'
    echo ""
    echo -e "${CYAN}Pattern blocks (Host *) stay where they are.${NC}"

    if [[ "${SSH_ADD_HOST_ASSUME_YES:-}" != "1" ]]; then
        local reply
        read -p "Proceed? (y/N): " reply
        [[ "$reply" =~ ^[Yy]$ ]] || { echo "Cancelled"; return 0; }
    fi

    local snap
    snap="$(mktemp -d)"
    local h
    for h in $hosts; do
        snapshot_host "$h" > "$snap/before.$h"
    done

    local backup
    backup="$CONFIG_FILE.bak.$(date +%Y%m%d_%H%M%S)"
    cp "$CONFIG_FILE" "$backup"

    ensure_include

    local tmp
    tmp="$(mktemp)"

    # Capture a Host block as its `Host` line plus the indented lines under it,
    # stopping at the first line that is not indented. That is conservative: it
    # cannot swallow a following Include or any other top-level directive. If a
    # config indents nothing, the block is under-captured — and the verification
    # below catches it rather than letting it through.
    awk -v dir="$HOSTS_DIR" '
        function writeout(   i, f) {
            f = dir "/" alias ".conf"
            for (i = 1; i <= nb; i++) print bbuf[i] > f
            close(f)
            cap = 0; nb = 0
        }
        function flush_comments(   i) {
            for (i = 1; i <= nc; i++) print cbuf[i]
            nc = 0
        }
        /^[[:space:]]*#/ && !cap { cbuf[++nc] = $0; next }
        /^[[:space:]]*Host[[:space:]]+/ {
            if (cap) writeout()
            rest = $0
            sub(/^[[:space:]]*Host[[:space:]]+/, "", rest)
            if (rest ~ /[*?!]/) { flush_comments(); print; next }
            alias = $2
            cap = 1; nb = 0
            for (i = 1; i <= nc; i++) bbuf[++nb] = cbuf[i]
            nc = 0
            bbuf[++nb] = $0
            next
        }
        cap && /^[[:space:]]/ && !/^[[:space:]]*$/ { bbuf[++nb] = $0; next }
        cap { writeout() }
        { flush_comments(); print }
        END { if (cap) writeout(); flush_comments() }
    ' "$CONFIG_FILE" > "$tmp"

    mv "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    for h in $hosts; do
        [[ -f "$(host_conf_file "$h")" ]] && chmod 600 "$(host_conf_file "$h")"
    done

    local changed=""
    for h in $hosts; do
        snapshot_host "$h" > "$snap/after.$h"
        diff -q "$snap/before.$h" "$snap/after.$h" >/dev/null 2>&1 || changed="$changed $h"
    done

    if [[ -n "$changed" ]]; then
        echo -e "${RED}✗ Splitting changed how ssh resolves:${changed}${NC}"
        for h in $changed; do
            echo -e "${YELLOW}  $h:${NC}"
            diff "$snap/before.$h" "$snap/after.$h" | grep -E '^[<>]' | sed 's/^/    /'
        done
        echo -e "${BLUE}Rolling everything back...${NC}"
        for h in $hosts; do rm -f "$(host_conf_file "$h")"; done
        mv "$backup" "$CONFIG_FILE"
        chmod 600 "$CONFIG_FILE"
        rm -rf "$snap"
        echo -e "${GREEN}✓ Restored ~/.ssh/config — nothing was changed${NC}"
        echo -e "${YELLOW}  A 'Host *' block above these hosts is overriding them.${NC}"
        echo -e "${YELLOW}  Reconcile that by hand first, then run split again.${NC}"
        return 1
    fi

    rm -rf "$snap"
    echo ""
    echo -e "${GREEN}✓ Split complete — every host resolves exactly as before${NC}"
    echo -e "${CYAN}  Backup: $backup${NC}"
    for h in $hosts; do
        echo -e "  ${GREEN}✓${NC} $(host_conf_file "$h")"
    done
}

# Test config parsing with ssh -G
test_config_parsing() {
    local host="$1"

    echo -e "${BLUE}Verifying config parsing...${NC}"

    if ! ssh -F "$CONFIG_FILE" -G "$host" &>/dev/null; then
        echo -e "${RED}✗ Config parsing failed, check ~/.ssh/config${NC}"
        return 1
    fi

    echo -e "${GREEN}✓ Config parsing successful${NC}"
    echo -e "${CYAN}Parsed result:${NC}"
    ssh -F "$CONFIG_FILE" -G "$host" 2>/dev/null | grep -E "^(user|hostname|port|identityfile|proxycommand)" | sed 's/^/  /'

    return 0
}

# Copy public key to server
copy_key_to_server() {
    local user="$1"
    local hostname="$2"
    local port="${3:-22}"
    local key_file="${4:-$SSH_DIR/id_ed25519}"

    key_file="${key_file/#\~/$HOME}"
    local pub_key_file="${key_file}.pub"

    if [[ ! -f "$pub_key_file" ]]; then
        echo -e "${RED}Error: Public key file not found: $pub_key_file${NC}"
        return 1
    fi

    echo -e "${BLUE}Copying public key to server...${NC}"
    echo -e "${YELLOW}You may be prompted once for the server password${NC}"

    if command -v ssh-copy-id &>/dev/null; then
        if ssh-copy-id -i "$key_file" -p "$port" "$user@$hostname"; then
            echo -e "${GREEN}✓ Public key copied to server${NC}"
            return 0
        fi
        echo -e "${YELLOW}ssh-copy-id failed, trying manual add...${NC}"
    else
        echo -e "${YELLOW}ssh-copy-id not found, trying manual add...${NC}"
    fi

    local pub_key
    pub_key=$(cat "$pub_key_file")

    if echo "$pub_key" | ssh -p "$port" "$user@$hostname" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys" 2>/dev/null; then
        echo -e "${GREEN}✓ Public key manually added to server${NC}"
        return 0
    fi

    echo -e "${RED}✗ Failed to copy public key${NC}"
    echo -e "${CYAN}Please manually copy this public key to server's ~/.ssh/authorized_keys:${NC}"
    cat "$pub_key_file"
    return 1
}

# Test passwordless connection
test_connection() {
    local host="$1"
    local max_attempts=2
    local attempt=1

    echo ""
    echo -e "${BLUE}Testing passwordless connection...${NC}"

    while [[ $attempt -le $max_attempts ]]; do
        if ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
               "$host" "echo '✓ Passwordless login successful'" 2>/dev/null; then
            echo ""
            echo -e "${GREEN}================================${NC}"
            echo -e "${GREEN}  Setup Complete!${NC}"
            echo -e "${GREEN}  Use: ssh $host${NC}"
            echo -e "${GREEN}================================${NC}"
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    echo -e "${RED}✗ Passwordless connection test failed${NC}"
    echo -e "${YELLOW}Possible causes:${NC}"
    echo "  - Incorrect permissions on server ~/.ssh/authorized_keys"
    echo "  - SSH service doesn't allow key authentication"
    echo "  - Incorrect permissions on server ~/.ssh directory"
    echo ""
    echo -e "${CYAN}Debug with: ssh -v $host${NC}"
    return 1
}

# Show config summary
show_summary() {
    echo ""
    echo -e "${BLUE}=== Configuration Summary ===${NC}"
    echo -e "  Host Alias: ${CYAN}$HOST_ALIAS${NC}"
    echo -e "  Server Address: ${CYAN}$SERVER_HOST${NC}"
    echo -e "  Username: ${CYAN}$USERNAME${NC}"
    echo -e "  Port: ${CYAN}${PORT:-22}${NC}"
    echo -e "  Identity File: ${CYAN}${IDENTITY:-$SSH_DIR/id_ed25519}${NC}"
}

# Main function
main() {
    echo -e "${BLUE}=== SSH Server Add Tool ===${NC}\n"

    check_dependencies

    if [[ $# -ge 3 ]]; then
        HOST_ALIAS="$1"
        USERNAME="$2"
        SERVER_HOST="$3"
        PORT="${4:-22}"
        IDENTITY="${5:-$SSH_DIR/id_ed25519}"
        AUTO_CONFIRM=true
    else
        AUTO_CONFIRM=false
        echo -e "${YELLOW}Please enter server information:${NC}"
        read -p "Host alias (e.g., myserver): " HOST_ALIAS
        read -p "Username: " USERNAME
        read -p "Server address (IP or hostname): " SERVER_HOST
        read -p "Port [22]: " PORT
        PORT=${PORT:-22}
        read -p "Identity file [~/.ssh/id_ed25519]: " IDENTITY
        IDENTITY=${IDENTITY:-$SSH_DIR/id_ed25519}
    fi

    if [[ -z "$HOST_ALIAS" || -z "$SERVER_HOST" || -z "$USERNAME" ]]; then
        echo -e "${RED}Error: Host alias, server address, and username are required${NC}"
        exit 1
    fi

    show_summary

    if [[ "$AUTO_CONFIRM" != true ]]; then
        echo ""
        read -p "Confirm add? (Y/n): " confirm
        if [[ "$confirm" =~ ^[Nn]$ ]]; then
            echo "Operation cancelled"
            exit 0
        fi
    fi

    echo ""

    check_and_generate_key

    echo ""
    add_to_config "$HOST_ALIAS" "$SERVER_HOST" "$USERNAME" "$PORT" "$IDENTITY"

    echo ""
    test_config_parsing "$HOST_ALIAS"

    echo ""
    if ! copy_key_to_server "$USERNAME" "$SERVER_HOST" "$PORT" "$IDENTITY"; then
        echo ""
        echo -e "${RED}================================${NC}"
        echo -e "${RED}  Setup Failed${NC}"
        echo -e "${RED}================================${NC}"
        echo ""
        echo -e "${YELLOW}Public key was not copied to server.${NC}"
        echo -e "${YELLOW}Please manually add the public key and try again.${NC}"
        exit 1
    fi

    test_connection "$HOST_ALIAS"
}

# Show help
show_help() {
    cat << 'EOF'
Usage: ssh-add-host [alias] [username] [address] [port] [identity_file]

Interactive mode:
    ssh-add-host

Command line mode:
    ssh-add-host myserver root 192.168.1.100
    ssh-add-host prod-server ubuntu example.com 22
    ssh-add-host myserver user example.com 22 ~/.ssh/my_key

Arguments:
    alias         Host alias in SSH config
    username      Login username
    address       Server IP or hostname
    port          SSH port (default: 22)
    identity_file Private key path (default: ~/.ssh/id_ed25519)

Remove a host:
    ssh-add-host remove myserver

Split an existing config (for a machine whose hosts are all in ~/.ssh/config):
    ssh-add-host split

    Moves every concrete Host block into its own file. `Host *` pattern blocks
    stay put: their meaning depends on their position, and hoisting one into an
    Include would change which value ssh sees first.

    Splitting is not automatically safe. ssh takes the FIRST value it sees for a
    keyword, so a `Host *` block above a host block wins over it today — move the
    host into config.d and the Include at the top makes the host win instead. The
    value flips and ssh says nothing. So every host is compared before and after,
    and if anything resolves differently the whole split is rolled back.

Where configs live:
    Each host gets its own file at ~/.ssh/config.d/<alias>.conf, pulled in by
    "Include config.d/*.conf" in ~/.ssh/config. One file per host means adding,
    replacing and removing a server is a file operation rather than line surgery
    on your whole ssh config.

Features:
    - Generates passphrase-protected keys and loads them into ssh-agent, so the
      passphrase is typed once rather than on every connection
    - Auto-detect and handle duplicate Host aliases (overwrite/skip/rename)
    - Verify config parsing with ssh -G
    - Auto-copy public key to server
    - Test passwordless connection

EOF
}

# Handle arguments
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    ensure-agent-config)
        # Used by dotfiles/install.sh so the block is written by one implementation
        # only. Optional second argument: path to the canonical ssh/agent.conf.
        ensure_include
        ensure_agent_config "${2:-}"
        exit $?
        ;;
    remove|rm)
        if [[ -z "${2:-}" ]]; then
            echo -e "${RED}Usage: ssh-add-host remove <alias>${NC}"
            exit 1
        fi
        remove_host "$2"
        exit $?
        ;;
    split)
        # For a machine whose hosts are still lumped into ~/.ssh/config.
        split_config
        exit $?
        ;;
    *)
        main "$@"
        ;;
esac
