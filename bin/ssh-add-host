#!/bin/bash

# SSH Server Add Tool - Auto-configure passwordless login
# Usage: ssh-add-host [alias] [address] [username] [port]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# SSH config directories
SSH_DIR="$HOME/.ssh"
CONFIG_FILE="$SSH_DIR/config"

# Ensure SSH directory exists
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"

# Check dependencies
check_dependencies() {
    if ! command -v ssh &>/dev/null; then
        echo -e "${RED}Error: ssh command not found${NC}"
        exit 1
    fi
}

# Check and generate SSH key
check_and_generate_key() {
    local key_type="${1:-ed25519}"
    local key_file="$SSH_DIR/id_${key_type}"

    if [[ -f "$key_file" ]]; then
        echo -e "${GREEN}✓ SSH key exists: $key_file${NC}"
        return 0
    fi

    echo -e "${YELLOW}No SSH key found, generating...${NC}"
    read -p "Enter key comment (usually email) [$(whoami)@$(hostname)]: " key_comment
    key_comment=${key_comment:-"$(whoami)@$(hostname)"}

    ssh-keygen -t "$key_type" -C "$key_comment" -f "$key_file" -N ""
    echo -e "${GREEN}✓ SSH key generated: $key_file${NC}"
    echo -e "${CYAN}Public key content:${NC}"
    cat "${key_file}.pub"
}

# Find Host location in config file
find_host_in_config() {
    local host="$1"
    local line_num=0
    local start_line=0
    local end_line=0
    local total_lines=0

    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "NOT_FOUND"
        return
    fi

    total_lines=$(wc -l < "$CONFIG_FILE")

    while IFS= read -r line; do
        ((line_num++))
        if [[ "$line" =~ ^Host[[:space:]]+(.+)$ ]]; then
            local hosts="${BASH_REMATCH[1]}"
            for h in $hosts; do
                if [[ "$h" == "$host" ]]; then
                    start_line=$line_num
                    break 2
                fi
            done
        fi
    done < "$CONFIG_FILE"

    if [[ $start_line -eq 0 ]]; then
        echo "NOT_FOUND"
        return
    fi

    end_line=$total_lines
    line_num=$start_line
    while IFS= read -r line; do
        ((line_num++))
        if [[ $line_num -le $start_line ]]; then
            continue
        fi
        if [[ "$line" =~ ^Host[[:space:]] ]]; then
            end_line=$((line_num - 1))
            break
        fi
    done < "$CONFIG_FILE"

    echo "${start_line},${end_line}"
}

# Remove Host section from config
remove_host_from_config() {
    local host="$1"
    local range
    range=$(find_host_in_config "$host")

    if [[ "$range" == "NOT_FOUND" ]]; then
        return 1
    fi

    local start_line=${range%,*}
    local end_line=${range#*,}

    local temp_file
    temp_file=$(mktemp)

    sed "${start_line},${end_line}d" "$CONFIG_FILE" > "$temp_file"
    mv "$temp_file" "$CONFIG_FILE"

    sed -i.bak '/^[[:space:]]*$/N;/^[[:space:]]*\n[[:space:]]*$/D' "$CONFIG_FILE" 2>/dev/null || true
    rm -f "$CONFIG_FILE.bak"

    return 0
}

# Handle duplicate Host
handle_duplicate_host() {
    local host="$1"
    local range
    range=$(find_host_in_config "$host")

    if [[ "$range" == "NOT_FOUND" ]]; then
        return 0
    fi

    echo -e "${YELLOW}⚠ Host alias '$host' already exists in config${NC}"

    local start_line=${range%,*}
    local end_line=${range#*,}
    echo -e "${CYAN}Existing config (lines $start_line-$end_line):${NC}"
    sed -n "${start_line},${end_line}p" "$CONFIG_FILE" | sed 's/^/  /'

    echo ""
    echo "Choose an action:"
    echo "  1) Overwrite - Remove existing config and use new one"
    echo "  2) Skip - Keep existing config and exit"
    echo "  3) Rename - Use a different alias"

    while true; do
        read -p "Enter option [1/2/3]: " choice
        case $choice in
            1)
                echo -e "${BLUE}Removing existing config...${NC}"
                remove_host_from_config "$host"
                echo -e "${GREEN}✓ Existing config removed${NC}"
                return 0
                ;;
            2)
                echo "Operation cancelled, existing config preserved"
                exit 0
                ;;
            3)
                read -p "Enter new host alias: " new_host
                if [[ -z "$new_host" ]]; then
                    echo -e "${RED}Alias cannot be empty${NC}"
                    continue
                fi
                HOST_ALIAS="$new_host"
                handle_duplicate_host "$new_host"
                return $?
                ;;
            *)
                echo -e "${RED}Invalid option, please try again${NC}"
                ;;
        esac
    done
}

# Backup config file
backup_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local backup_file="$CONFIG_FILE.bak.$(date +%Y%m%d_%H%M%S)"
        cp "$CONFIG_FILE" "$backup_file"
        echo -e "${BLUE}Config backed up to: $backup_file${NC}"
    fi
}

# Add config to SSH config
add_to_config() {
    local host="$1"
    local hostname="$2"
    local user="$3"
    local port="${4:-22}"
    local identity_file="${5:-$SSH_DIR/id_ed25519}"

    identity_file="${identity_file/#\~/$HOME}"

    backup_config

    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    handle_duplicate_host "$host"

    {
        echo ""
        echo "Host $host"
        echo "    HostName $hostname"
        echo "    User $user"
        echo "    Port $port"
        echo "    IdentityFile $identity_file"
        echo "    IdentitiesOnly yes"
        echo "    ServerAliveInterval 60"
        echo "    ServerAliveCountMax 3"
    } >> "$CONFIG_FILE"

    echo -e "${GREEN}✓ SSH config added${NC}"
}

# Test config parsing with ssh -G
test_config_parsing() {
    local host="$1"

    echo -e "${BLUE}Verifying config parsing...${NC}"

    if ! ssh -G "$host" &>/dev/null; then
        echo -e "${RED}✗ Config parsing failed, check ~/.ssh/config${NC}"
        return 1
    fi

    echo -e "${GREEN}✓ Config parsing successful${NC}"
    echo -e "${CYAN}Parsed result:${NC}"
    ssh -G "$host" 2>/dev/null | grep -E "^(user|hostname|port|identityfile|proxycommand)" | sed 's/^/  /'

    return 0
}

# Copy public key to server
copy_key_to_server() {
    local user="$1"
    local hostname="$2"
    local port="${3:-22}"
    local key_file="${4:-$SSH_DIR/id_ed25519}"

    local pub_key_file="${key_file}.pub"

    if [[ ! -f "$pub_key_file" ]]; then
        echo -e "${RED}Error: Public key file not found: $pub_key_file${NC}"
        return 1
    fi

    echo -e "${BLUE}Copying public key to server...${NC}"
    echo -e "${YELLOW}First login requires server password${NC}"

    if ! ssh -o ConnectTimeout=10 -o BatchMode=no -p "$port" "$user@$hostname" "echo 'password auth ok'" &>/dev/null; then
        echo -e "${YELLOW}Cannot connect with password, you may need to manually add the public key${NC}"
        echo -e "${CYAN}Please manually copy this public key to server's ~/.ssh/authorized_keys:${NC}"
        cat "$pub_key_file"
        return 1
    fi

    if ssh-copy-id -i "$key_file" -p "$port" "$user@$hostname" 2>/dev/null; then
        echo -e "${GREEN}✓ Public key copied to server${NC}"
        return 0
    fi

    echo -e "${YELLOW}ssh-copy-id failed, trying manual add...${NC}"
    local pub_key
    pub_key=$(cat "$pub_key_file")

    if ssh -p "$port" "$user@$hostname" "mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo '$pub_key' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys" 2>/dev/null; then
        echo -e "${GREEN}✓ Public key manually added to server${NC}"
        return 0
    fi

    echo -e "${RED}✗ Failed to copy public key${NC}"
    echo -e "${CYAN}Please manually copy this public key to server's ~/.ssh/authorized_keys:${NC}"
    cat "$pub_key_file"
    return 1
}

# Test passwordless connection
test_connection() {
    local host="$1"
    local max_attempts=2
    local attempt=1

    echo ""
    echo -e "${BLUE}Testing passwordless connection...${NC}"

    while [[ $attempt -le $max_attempts ]]; do
        if ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
               "$host" "echo '✓ Passwordless login successful'" 2>/dev/null; then
            echo ""
            echo -e "${GREEN}================================${NC}"
            echo -e "${GREEN}  Setup Complete!${NC}"
            echo -e "${GREEN}  Use: ssh $host${NC}"
            echo -e "${GREEN}================================${NC}"
            return 0
        fi
        ((attempt++))
        sleep 1
    done

    echo -e "${RED}✗ Passwordless connection test failed${NC}"
    echo -e "${YELLOW}Possible causes:${NC}"
    echo "  - Incorrect permissions on server ~/.ssh/authorized_keys"
    echo "  - SSH service doesn't allow key authentication"
    echo "  - Incorrect permissions on server ~/.ssh directory"
    echo ""
    echo -e "${CYAN}Debug with: ssh -v $host${NC}"
    return 1
}

# Show config summary
show_summary() {
    echo ""
    echo -e "${BLUE}=== Configuration Summary ===${NC}"
    echo -e "  Host Alias: ${CYAN}$HOST_ALIAS${NC}"
    echo -e "  Server Address: ${CYAN}$HOSTNAME${NC}"
    echo -e "  Username: ${CYAN}$USERNAME${NC}"
    echo -e "  Port: ${CYAN}${PORT:-22}${NC}"
    echo -e "  Identity File: ${CYAN}${IDENTITY:-$SSH_DIR/id_ed25519}${NC}"
}

# Main function
main() {
    echo -e "${BLUE}=== SSH Server Add Tool ===${NC}\n"

    check_dependencies

    if [[ $# -ge 3 ]]; then
        HOST_ALIAS="$1"
        HOSTNAME="$2"
        USERNAME="$3"
        PORT="${4:-22}"
        IDENTITY="${5:-$SSH_DIR/id_ed25519}"
        AUTO_CONFIRM=true
    else
        AUTO_CONFIRM=false
        echo -e "${YELLOW}Please enter server information:${NC}"
        read -p "Host alias (e.g., myserver, ali-prod): " HOST_ALIAS
        read -p "Server address (IP or hostname): " HOSTNAME
        read -p "Username: " USERNAME
        read -p "Port [22]: " PORT
        PORT=${PORT:-22}
        read -p "Identity file [~/.ssh/id_ed25519]: " IDENTITY
        IDENTITY=${IDENTITY:-$SSH_DIR/id_ed25519}
    fi

    if [[ -z "$HOST_ALIAS" || -z "$HOSTNAME" || -z "$USERNAME" ]]; then
        echo -e "${RED}Error: Host alias, server address, and username are required${NC}"
        exit 1
    fi

    show_summary

    if [[ "$AUTO_CONFIRM" != true ]]; then
        echo ""
        read -p "Confirm add? (Y/n): " confirm
        if [[ "$confirm" =~ ^[Nn]$ ]]; then
            echo "Operation cancelled"
            exit 0
        fi
    fi

    echo ""

    check_and_generate_key

    echo ""
    add_to_config "$HOST_ALIAS" "$HOSTNAME" "$USERNAME" "$PORT" "$IDENTITY"

    echo ""
    test_config_parsing "$HOST_ALIAS"

    echo ""
    copy_key_to_server "$USERNAME" "$HOSTNAME" "$PORT" "$IDENTITY"

    test_connection "$HOST_ALIAS"
}

# Show help
show_help() {
    cat << 'EOF'
Usage: ssh-add-host [alias] [address] [username] [port] [identity_file]

Interactive mode:
    ssh-add-host

Command line mode:
    ssh-add-host myserver 192.168.1.100 root
    ssh-add-host ali-prod 47.100.xxx.xxx ubuntu 22
    ssh-add-host myserver example.com user 22 ~/.ssh/my_key

Arguments:
    alias         Host alias in SSH config
    address       Server IP or hostname
    username      Login username
    port          SSH port (default: 22)
    identity_file Private key path (default: ~/.ssh/id_ed25519)

Features:
    - Auto-detect and handle duplicate Host aliases (overwrite/skip/rename)
    - Verify config parsing with ssh -G
    - Auto-backup original config file
    - Auto-copy public key to server
    - Test passwordless connection

EOF
}

# Handle arguments
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    *)
        main "$@"
        ;;
esac
