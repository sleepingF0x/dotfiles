# Template for ~/.config/secrets/secrets.env
#
# Only variable NAMES live here, so a new machine knows what to fill in.
# Values are never committed. install.sh copies this file to
# ~/.config/secrets/secrets.env on a fresh machine; fill in the values there.
#
# Add a new variable by appending its name here (with an empty value) and
# committing. install.sh will then flag it as missing on every other machine.

JINA_API_KEY=
TWITTER_TOKEN=
