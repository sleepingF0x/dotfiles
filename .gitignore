# This is a PUBLIC repository. Nothing secret may ever be committed here.
# Real secret values live in ~/.config/secrets/*.env, outside this repo.
# Only secrets.env.example (variable names, empty values) is tracked.

# Env files with real values
.env
*.env
!*.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
!*.pub

# Credential stores
.netrc
.npmrc
.pypirc
credentials
authorized_keys
known_hosts

# ssh/ holds one public-safe file. Anything else dropped in here — a real
# ~/.ssh/config, a host list — would publish server addresses and usernames.
ssh/**
!ssh/agent.conf

# Local / machine-specific configs
*.local
.claude/settings.local.json
.claude/

# Tests stay local unless explicitly reviewed for this public repo
tests/*
!tests/install-secrets.sh

# Backup files (a backup of a secret is still a secret)
*.bak
*.backup
*.backup-*
*.backup.*
*~

# macOS
.DS_Store
