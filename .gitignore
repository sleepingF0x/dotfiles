# This is a PUBLIC repository. Nothing secret may ever be committed here.
# Real secret values live in ~/.config/secrets/*.env, outside this repo.
# Only secrets.env.example (variable names, empty values) is tracked.

# Env files with real values
.env
*.env
!*.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
id_ecdsa*
id_ed25519*
!*.pub

# Credential stores
.netrc
.npmrc
.pypirc
credentials
authorized_keys
known_hosts

# Local / machine-specific configs
*.local
.claude/settings.local.json
.claude/

# Tests stay local
tests/

# Backup files (a backup of a secret is still a secret)
*.bak
*.backup
*.backup-*
*.backup.*
*~

# macOS
.DS_Store
